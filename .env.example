# Zkopíruj do .env.local (lokálně) a do nastavení Netlify. Hodnoty sem NEPIŠ.

# Adresa webu (lokálně http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# TAJNÉ: jen server, nikdy s předponou NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Ecomail (milník 3)
ECOMAIL_API_KEY=
ECOMAIL_LIST_ID=

# Bunny Stream (milník 4)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_TOKEN_KEY=

# Resend: e-maily z kontaktního formuláře a konzultací (a SMTP pro přihlašovací e-maily v Supabase)
RESEND_API_KEY=
# Odesílatel na ověřené doméně, např. Vladimír PRO <info@tvoje-domena.cz>
MAIL_FROM=
# E-mail majitele, kam chodí zprávy z formulářů
CONTACT_TO_EMAIL=
